{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/t3-fleet/request.schema.json",
  "title": "T3 Fleet Request",
  "description": "Closed request contract for the t3-fleet controller. Prompt text is accepted only in JSON input or through prompt_file.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action"
  ],
  "properties": {
    "schema": {
      "const": "t3-fleet.request.v1"
    },
    "action": {
      "type": "string",
      "enum": [
        "doctor",
        "capacity",
        "submit",
        "status",
        "wait",
        "followup",
        "interrupt",
        "approve",
        "answer",
        "recover"
      ]
    },
    "request_id": {
      "$ref": "#/$defs/request_id"
    },
    "host": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "target": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "repository": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120000
    },
    "prompt_file": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "model_selection": {
      "$ref": "#/$defs/model_selection"
    },
    "runtime_mode": {
      "type": "string",
      "enum": [
        "approval-required",
        "auto-accept-edits",
        "auto",
        "full-access"
      ]
    },
    "interaction_mode": {
      "type": "string",
      "enum": [
        "default",
        "plan"
      ]
    },
    "run_setup_script": {
      "type": "boolean"
    },
    "allow_queue": {
      "type": "boolean"
    },
    "include_output": {
      "type": "boolean"
    },
    "timeout": {
      "type": "number",
      "minimum": 0,
      "maximum": 86400
    },
    "approval_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "decision": {
      "type": "string",
      "enum": [
        "accept",
        "acceptForSession",
        "decline",
        "cancel"
      ]
    },
    "input_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "answers": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 100,
      "patternProperties": {
        "^.{1,256}$": {}
      }
    }
  },
  "$defs": {
    "legacy_request_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{7,63}$"
    },
    "peer_request_id": {
      "type": "string",
      "maxLength": 166,
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}-[a-z0-9][a-z0-9-]{0,63}-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "request_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/legacy_request_id"
        },
        {
          "$ref": "#/$defs/peer_request_id"
        }
      ]
    },
    "model_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instanceId",
        "model"
      ],
      "properties": {
        "instanceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reasoningEffort": {
              "type": "string",
              "enum": [
                "none",
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh",
                "max",
                "ultra"
              ]
            },
            "serviceTier": {
              "type": "string",
              "enum": [
                "auto",
                "default",
                "flex",
                "priority"
              ]
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "submit"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "host",
          "repository",
          "source_revision",
          "title"
        ],
        "oneOf": [
          {
            "required": [
              "prompt"
            ],
            "not": {
              "required": [
                "prompt_file"
              ]
            }
          },
          {
            "required": [
              "prompt_file"
            ],
            "not": {
              "required": [
                "prompt"
              ]
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "enum": [
              "status",
              "wait",
              "interrupt"
            ]
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "request_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "recover"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "request_id"
            ]
          },
          {
            "required": [
              "target"
            ]
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "followup"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "request_id"
        ],
        "oneOf": [
          {
            "required": [
              "prompt"
            ],
            "not": {
              "required": [
                "prompt_file"
              ]
            }
          },
          {
            "required": [
              "prompt_file"
            ],
            "not": {
              "required": [
                "prompt"
              ]
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "approve"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "request_id",
          "approval_id",
          "decision"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "answer"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "request_id",
          "input_id",
          "answers"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "not": {
              "const": "recover"
            }
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "target": false
        }
      }
    }
  ]
}
