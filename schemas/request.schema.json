{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/t3-fleet/request.schema.json",
  "title": "T3 Fleet Request",
  "description": "Closed request contract for the t3-fleet controller. Prompt text is accepted only in JSON input or through prompt_file.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action"
  ],
  "properties": {
    "schema": {
      "const": "t3-fleet.request.v1"
    },
    "action": {
      "type": "string",
      "enum": [
        "doctor",
        "capacity",
        "submit",
        "status",
        "wait",
        "followup",
        "interrupt",
        "approve",
        "answer",
        "recover",
        "tick"
      ]
    },
    "request_id": {
      "$ref": "#/$defs/request_id"
    },
    "host": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "target": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "repository": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120000
    },
    "prompt_file": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "seat": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Logical Fleet Hub roster key. Under an enrolled controller an explicit seat is an override that requires override_reason; omit it to let the central route select the seat."
    },
    "runtime_mode": {
      "type": "string",
      "enum": [
        "approval-required",
        "auto-accept-edits",
        "auto",
        "full-access"
      ]
    },
    "interaction_mode": {
      "type": "string",
      "enum": [
        "default",
        "plan"
      ]
    },
    "run_setup_script": {
      "type": "boolean"
    },
    "allow_queue": {
      "type": "boolean",
      "description": "Explicitly allow this submission to be held in the controller's local outbox when a pre-launch capacity or offline block stops it, so a later `tick` can launch the same work without a second submit. Absent means the block fails the submit as before; `false` is an explicit refusal and is honoured as one. Never valid with `delegation_id`: an adopted delegation is one execution that already exists centrally."
    },
    "include_output": {
      "type": "boolean"
    },
    "timeout": {
      "type": "number",
      "minimum": 0,
      "maximum": 86400
    },
    "approval_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "decision": {
      "type": "string",
      "enum": [
        "accept",
        "acceptForSession",
        "decline",
        "cancel"
      ]
    },
    "input_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "answers": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 100,
      "patternProperties": {
        "^.{1,256}$": {}
      }
    },
    "override_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Operator justification required when an enrolled controller is given an explicit host or an explicit seat instead of central selection."
    },
    "workload": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "description": "What kind of work this request is, as input to central route eligibility. It is never a local machine-ranking override and needs no override_reason. Omitting it inherits the controller's configured workload. It requires fleet policy enrollment, and it is part of the request identity."
    },
    "delegation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "description": "Adopt an existing parent delegation instead of routing a new request. The consumer, adapter, decision, reservation, session, seat, workload, target machine, canonical repository, and immutable source revision all come from the receipt the Fleet Hub authors; supplied options may only confirm it. There is deliberately no consumer or adapter flag."
    }
  },
  "$defs": {
    "legacy_request_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{7,63}$"
    },
    "peer_request_id": {
      "type": "string",
      "maxLength": 166,
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}-[a-z0-9][a-z0-9-]{0,63}-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "request_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/legacy_request_id"
        },
        {
          "$ref": "#/$defs/peer_request_id"
        }
      ]
    },
    "seat": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "submit"
          }
        },
        "required": [
          "action"
        ],
        "not": {
          "required": [
            "delegation_id"
          ]
        }
      },
      "then": {
        "required": [
          "host",
          "repository",
          "source_revision",
          "title"
        ],
        "oneOf": [
          {
            "required": [
              "prompt"
            ],
            "not": {
              "required": [
                "prompt_file"
              ]
            }
          },
          {
            "required": [
              "prompt_file"
            ],
            "not": {
              "required": [
                "prompt"
              ]
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "submit"
          }
        },
        "required": [
          "action",
          "delegation_id"
        ]
      },
      "then": {
        "required": [
          "title"
        ],
        "properties": {
          "request_id": false,
          "override_reason": false
        },
        "oneOf": [
          {
            "required": [
              "prompt"
            ],
            "not": {
              "required": [
                "prompt_file"
              ]
            }
          },
          {
            "required": [
              "prompt_file"
            ],
            "not": {
              "required": [
                "prompt"
              ]
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "enum": [
              "status",
              "wait",
              "interrupt"
            ]
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "request_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "recover"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "request_id"
            ]
          },
          {
            "required": [
              "target"
            ]
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "followup"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "request_id"
        ],
        "oneOf": [
          {
            "required": [
              "prompt"
            ],
            "not": {
              "required": [
                "prompt_file"
              ]
            }
          },
          {
            "required": [
              "prompt_file"
            ],
            "not": {
              "required": [
                "prompt"
              ]
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "approve"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "request_id",
          "approval_id",
          "decision"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "answer"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "request_id",
          "input_id",
          "answers"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "not": {
              "const": "recover"
            }
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "target": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "not": {
              "const": "submit"
            }
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "delegation_id": false,
          "workload": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "tick"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "description": "`tick` carries no request fields. It drains work a caller already submitted and already authorized, so there is nothing here to name, narrow, or re-approve.",
        "properties": {
          "request_id": false,
          "host": false,
          "repository": false,
          "source_revision": false,
          "title": false,
          "prompt": false,
          "prompt_file": false,
          "seat": false,
          "workload": false,
          "delegation_id": false,
          "override_reason": false,
          "runtime_mode": false,
          "interaction_mode": false,
          "run_setup_script": false,
          "allow_queue": false,
          "include_output": false,
          "timeout": false,
          "approval_id": false,
          "decision": false,
          "answers": false,
          "input_id": false,
          "target": false
        }
      }
    }
  ]
}
